---
// Fixed ad spot (top / mid / sidebar). Shows NOTHING until both your AdSense
// publisher ID and this spot's ad-unit ID are filled in under ADS in
// src/data/site.ts, so visitors never see empty boxes.
// Auto ads (just the publisher ID) place ads on their own and don't need these spots.
import { ADS, adsensePubId } from '../data/site';
interface Props { position: 'top' | 'mid' | 'sidebar' }
const { position } = Astro.props;
const pubId = adsensePubId();
const slotId = ADS.slots[position]?.trim() ?? '';
const show = Boolean(pubId && slotId);
---
{show && (
  <aside class:list={['ad-slot', position]} data-ad-slot={position} aria-label="Advertisement">
    <ins
      class="adsbygoogle"
      style="display:block;width:100%"
      data-ad-client={`ca-${pubId}`}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
